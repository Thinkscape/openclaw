From a2284e03e286a33cbda69d42540e07de16598c7c Mon Sep 17 00:00:00 2001
From: Test User <test@example.com>
Date: Mon, 18 May 2026 11:21:24 +1000
Subject: [PATCH] feat(config): make subagent spawn self-call timeout
 configurable

---
 src/agents/subagent-spawn.ts                  | 29 +++++++++++++++----
 .../config.agent-concurrency-defaults.test.ts |  4 ++-
 src/config/types.agent-defaults.ts            |  5 ++++
 src/config/zod-schema.agent-defaults.ts       |  8 +++++
 4 files changed, 40 insertions(+), 6 deletions(-)

diff --git a/src/agents/subagent-spawn.ts b/src/agents/subagent-spawn.ts
index 1801a6f7515..189b81f40da 100644
--- a/src/agents/subagent-spawn.ts
+++ b/src/agents/subagent-spawn.ts
@@ -113,6 +113,7 @@ let subagentSpawnDeps: SubagentSpawnDeps = defaultSubagentSpawnDeps;
 const SUBAGENT_CONTROL_GATEWAY_TIMEOUT_MS = 60_000;
 const DEFAULT_SUBAGENT_AGENT_GATEWAY_TIMEOUT_MS = 60_000;
 const MAX_SUBAGENT_AGENT_GATEWAY_TIMEOUT_MS = 300_000;
+const MAX_TIMER_SAFE_TIMEOUT_MS = 2_147_000_000;
 
 export type SpawnSubagentParams = {
   task: string;
@@ -261,6 +262,16 @@ function loadSubagentConfig() {
   return subagentSpawnDeps.getRuntimeConfig();
 }
 
+export function resolveSubagentGatewayTimeoutMs(
+  cfg: ReturnType<typeof getRuntimeConfig>,
+): number | undefined {
+  const configured = cfg.agents?.defaults?.subagents?.gatewayTimeoutMs;
+  if (typeof configured !== "number" || !Number.isFinite(configured)) {
+    return undefined;
+  }
+  return Math.min(Math.max(1, Math.floor(configured)), MAX_TIMER_SAFE_TIMEOUT_MS);
+}
+
 async function persistInitialChildSessionRuntimeModel(params: {
   cfg: OpenClawConfig;
   childSessionKey: string;
@@ -500,6 +511,7 @@ async function cleanupProvisionalSession(
   options?: {
     emitLifecycleHooks?: boolean;
     deleteTranscript?: boolean;
+    gatewayTimeoutMs?: number;
   },
 ): Promise<void> {
   try {
@@ -510,7 +522,7 @@ async function cleanupProvisionalSession(
         emitLifecycleHooks: options?.emitLifecycleHooks === true,
         deleteTranscript: options?.deleteTranscript === true,
       },
-      timeoutMs: SUBAGENT_CONTROL_GATEWAY_TIMEOUT_MS,
+      timeoutMs: options?.gatewayTimeoutMs ?? SUBAGENT_CONTROL_GATEWAY_TIMEOUT_MS,
     });
   } catch {
     // Best-effort cleanup only.
@@ -522,6 +534,7 @@ async function cleanupFailedSpawnBeforeAgentStart(params: {
   attachmentAbsDir?: string;
   emitLifecycleHooks?: boolean;
   deleteTranscript?: boolean;
+  gatewayTimeoutMs?: number;
 }): Promise<void> {
   if (params.attachmentAbsDir) {
     try {
@@ -533,6 +546,7 @@ async function cleanupFailedSpawnBeforeAgentStart(params: {
   await cleanupProvisionalSession(params.childSessionKey, {
     emitLifecycleHooks: params.emitLifecycleHooks,
     deleteTranscript: params.deleteTranscript,
+    gatewayTimeoutMs: params.gatewayTimeoutMs,
   });
 }
 
@@ -731,6 +745,7 @@ export async function spawnSubagentDirect(
     cfg,
     runTimeoutSeconds: params.runTimeoutSeconds,
   });
+  const subagentGatewayTimeoutMs = resolveSubagentGatewayTimeoutMs(cfg);
   let modelApplied = false;
   let threadBindingReady = false;
   let hasBoundThreadDeliveryOrigin = false;
@@ -922,6 +937,7 @@ export async function spawnSubagentDirect(
     await cleanupProvisionalSession(childSessionKey, {
       emitLifecycleHooks: false,
       deleteTranscript: true,
+      gatewayTimeoutMs: subagentGatewayTimeoutMs,
     });
     return {
       status: "error",
@@ -940,7 +956,7 @@ export async function spawnSubagentDirect(
         await callSubagentGateway({
           method: "sessions.delete",
           params: { key: childSessionKey, emitLifecycleHooks: false },
-          timeoutMs: SUBAGENT_CONTROL_GATEWAY_TIMEOUT_MS,
+          timeoutMs: subagentGatewayTimeoutMs ?? SUBAGENT_CONTROL_GATEWAY_TIMEOUT_MS,
         });
       } catch {
         // Best-effort cleanup only.
@@ -973,7 +989,7 @@ export async function spawnSubagentDirect(
         await callSubagentGateway({
           method: "sessions.delete",
           params: { key: childSessionKey, deleteTranscript: true, emitLifecycleHooks: false },
-          timeoutMs: SUBAGENT_CONTROL_GATEWAY_TIMEOUT_MS,
+          timeoutMs: subagentGatewayTimeoutMs ?? SUBAGENT_CONTROL_GATEWAY_TIMEOUT_MS,
         });
       } catch {
         // Best-effort cleanup only.
@@ -1027,6 +1043,7 @@ export async function spawnSubagentDirect(
     await cleanupProvisionalSession(childSessionKey, {
       emitLifecycleHooks: threadBindingReady,
       deleteTranscript: true,
+      gatewayTimeoutMs: subagentGatewayTimeoutMs,
     });
     return {
       status: materializedAttachments.status,
@@ -1079,6 +1096,7 @@ export async function spawnSubagentDirect(
       attachmentAbsDir,
       emitLifecycleHooks: threadBindingReady,
       deleteTranscript: true,
+      gatewayTimeoutMs: subagentGatewayTimeoutMs,
     });
     return {
       status: "error",
@@ -1099,6 +1117,7 @@ export async function spawnSubagentDirect(
       attachmentAbsDir,
       emitLifecycleHooks: threadBindingReady,
       deleteTranscript: true,
+      gatewayTimeoutMs: subagentGatewayTimeoutMs,
     });
     return {
       status: "error",
@@ -1204,7 +1223,7 @@ export async function spawnSubagentDirect(
           deleteTranscript: true,
           emitLifecycleHooks,
         },
-        timeoutMs: SUBAGENT_CONTROL_GATEWAY_TIMEOUT_MS,
+        timeoutMs: subagentGatewayTimeoutMs ?? SUBAGENT_CONTROL_GATEWAY_TIMEOUT_MS,
       });
     } catch {
       // Best-effort only.
@@ -1257,7 +1276,7 @@ export async function spawnSubagentDirect(
           deleteTranscript: true,
           emitLifecycleHooks: threadBindingReady,
         },
-        timeoutMs: SUBAGENT_CONTROL_GATEWAY_TIMEOUT_MS,
+        timeoutMs: subagentGatewayTimeoutMs ?? SUBAGENT_CONTROL_GATEWAY_TIMEOUT_MS,
       });
     } catch {
       // Best-effort cleanup only.
diff --git a/src/config/config.agent-concurrency-defaults.test.ts b/src/config/config.agent-concurrency-defaults.test.ts
index f5bda63b0ed..5f663480501 100644
--- a/src/config/config.agent-concurrency-defaults.test.ts
+++ b/src/config/config.agent-concurrency-defaults.test.ts
@@ -27,13 +27,14 @@ describe("agent concurrency defaults", () => {
     expect(resolveSubagentMaxConcurrent(cfg)).toBe(1);
   });
 
-  it("accepts subagent spawn depth and per-agent child limits", () => {
+  it("accepts subagent spawn depth, child limits and gateway timeout", () => {
     const parsed = OpenClawSchema.parse({
       agents: {
         defaults: {
           subagents: {
             maxSpawnDepth: 2,
             maxChildrenPerAgent: 7,
+            gatewayTimeoutMs: 25_000,
           },
         },
       },
@@ -41,6 +42,7 @@ describe("agent concurrency defaults", () => {
 
     expect(parsed.agents?.defaults?.subagents?.maxSpawnDepth).toBe(2);
     expect(parsed.agents?.defaults?.subagents?.maxChildrenPerAgent).toBe(7);
+    expect(parsed.agents?.defaults?.subagents?.gatewayTimeoutMs).toBe(25_000);
   });
 
   it("injects missing agent defaults", () => {
diff --git a/src/config/types.agent-defaults.ts b/src/config/types.agent-defaults.ts
index 5bfe11c418e..ebbccff7821 100644
--- a/src/config/types.agent-defaults.ts
+++ b/src/config/types.agent-defaults.ts
@@ -441,6 +441,11 @@ export type AgentDefaultsConfig = {
     thinking?: string;
     /** Default run timeout in seconds for spawned sub-agents (0 = no timeout). */
     runTimeoutSeconds?: number;
+    /**
+     * Internal gateway timeout in milliseconds for sub-agent spawn self-calls
+     * (sessions.patch / agent / sessions.delete). Default: 10000.
+     */
+    gatewayTimeoutMs?: number;
     /** Gateway timeout in ms for sub-agent announce delivery calls (default: 120000). */
     announceTimeoutMs?: number;
     /** Require explicit agentId in sessions_spawn (no default same-as-caller). Default: false. */
diff --git a/src/config/zod-schema.agent-defaults.ts b/src/config/zod-schema.agent-defaults.ts
index 9621509db44..9c3e91e0eb0 100644
--- a/src/config/zod-schema.agent-defaults.ts
+++ b/src/config/zod-schema.agent-defaults.ts
@@ -284,6 +284,14 @@ export const AgentDefaultsSchema = z
         model: AgentModelSchema.optional(),
         thinking: z.string().optional(),
         runTimeoutSeconds: z.number().int().min(0).optional(),
+        gatewayTimeoutMs: z
+          .number()
+          .int()
+          .positive()
+          .optional()
+          .describe(
+            "Internal gateway timeout in milliseconds for sub-agent spawn self-calls such as sessions.patch, agent, and sessions.delete (default: 10000). Increase on slower gateways or remote filesystems that delay child acceptance.",
+          ),
         announceTimeoutMs: z.number().int().positive().optional(),
         requireAgentId: z.boolean().optional(),
       })
